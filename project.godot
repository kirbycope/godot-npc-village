; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot NPC Village"
config/version="0.1.0"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[autoload]

Secrets="*res://scripts/services/secrets.gd"
VoiceService="*res://scripts/services/voice_service.gd"
ConversationDirector="*res://scripts/conversation/conversation_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/3d_player_controller/plugin.cfg", "res://addons/controls/plugin.cfg", "res://addons/date_and_time/plugin.cfg", "res://addons/weather_fx/plugin.cfg")

[importer_defaults]

texture={
&"compress/mode": 1,
&"detect_3d/compress_to": 0,
&"process/size_limit": 512
}

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2

[shader_globals]

weather_wind_strength={
"type": "float",
"value": 0.0
}
weather_wind_direction={
"type": "vec3",
"value": Vector3(1, 0, 0)
}
weather_precipitation_strength={
"type": "float",
"value": 0.0
}
weather_foliage_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
weather_grass_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
